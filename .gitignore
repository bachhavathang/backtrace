# Credentials. `.env.*` is deliberately broad — a bare `.env` pattern does NOT
# match .env.local / .env.backup / .env.example, which is how a real key ends up
# committed. The template is the one explicit exception.
.env
.env.*
!.env.example

__pycache__/
*.pyc
.venv/
.pytest_cache/
data/mock_systems/recovery_ledger.json
# LLM call log: full prompt/response provenance, regenerated on every scan.
data/logs/
evals/results/

# Personal files that live in the working directory but are not part of the project.
Athang_Bachhav_CV.*

# Harvested real data: large, re-fetchable, and dated. The manifest inside each
# snapshot records what was fetched; tests use tests/fixtures/ instead.
data/raw/
# Corpus embeddings: derived, keyed on content, rebuilt on a miss.
data/cache/
# Generated eval sets, rebuilt from a snapshot + seed.
data/derived/
