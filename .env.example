# TEMPLATE ONLY — this file IS committed. Never put a real key here.
# Copy it to `.env` (which is gitignored) and fill the value in there instead:
#
#   cp .env.example .env          # bash
#   Copy-Item .env.example .env   # PowerShell
#
# A real environment variable always overrides what is set here, so an export or
# a one-off `$env:ANTHROPIC_API_KEY` still wins over this file.

ANTHROPIC_API_KEY=

# Optional. Only set when routing through a gateway that issues its own tokens.
# ANTHROPIC_AUTH_TOKEN=
